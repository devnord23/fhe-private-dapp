# ============================================================
# ConfidentialFi – Frontend Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# ── WalletConnect / RainbowKit ───────────────────────────────
# Required. Obtain at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ── Zama Devnet (primary fhEVM testnet, chain ID 9000) ───────
# Deploy contracts/contracts/ConfidentialToken.sol here first.
# See contracts/scripts/deploy.ts.
NEXT_PUBLIC_CONTRACT_ADDRESS_ZAMA_DEVNET=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ZAMA_DEVNET_RPC=https://devnet.zama.ai

# ── Zama fhEVM System Contracts ──────────────────────────────
# These are pre-deployed by Zama on their network.
# Find the CORRECT addresses for your target network at:
#   https://docs.zama.ai/fhevm/references/contracts
#
# Without these, fhevmjs cannot encrypt inputs or verify proofs.
# The addresses below are PLACEHOLDERS – do not use them.
NEXT_PUBLIC_FHEVM_ACL_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_FHEVM_KMS_ADDRESS=0x0000000000000000000000000000000000000000

# ── Ethereum Sepolia (chain ID 11155111) ─────────────────────
# Only works if Zama fhEVM precompiles are deployed on Sepolia.
# Check https://docs.zama.ai/fhevm for current network support.
NEXT_PUBLIC_CONTRACT_ADDRESS_SEPOLIA=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_RPC_URL_SEPOLIA=https://rpc.sepolia.org
