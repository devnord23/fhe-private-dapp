# ============================================================
# Confidential Transfer DApp – Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# ── WalletConnect / RainbowKit ───────────────────────────────
# Obtain a project ID from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ── Supported Networks ───────────────────────────────────────
# Comma-separated list of chain IDs the app supports.
# 1 = Ethereum Mainnet, 11155111 = Sepolia, 8453 = Base, 84532 = Base Sepolia
NEXT_PUBLIC_SUPPORTED_CHAIN_IDS=11155111,84532

# ── Confidential Token Contract ──────────────────────────────
# Address of the deployed ConfidentialToken contract on each network.
NEXT_PUBLIC_CONTRACT_ADDRESS_SEPOLIA=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CONTRACT_ADDRESS_BASE_SEPOLIA=0x0000000000000000000000000000000000000000

# ── RPC Endpoints (optional – override public defaults) ──────
# Using a private RPC (Alchemy, Infura, QuickNode) improves reliability.
NEXT_PUBLIC_RPC_URL_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
NEXT_PUBLIC_RPC_URL_BASE_SEPOLIA=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# ── Analytics / Monitoring (optional) ───────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_SENTRY_DSN=
