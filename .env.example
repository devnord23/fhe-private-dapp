# ============================================================
# ConfidentialFi — Private Agentic DeFi on Base
# Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# ── WalletConnect / RainbowKit ───────────────────────────────
# Required. Obtain at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ════════════════════════════════════════════════════════════
# LAYER 1: BASE (Settlement Chain)
# ════════════════════════════════════════════════════════════
# Base Sepolia (chain 84532) is the default wallet chain.
# Base mainnet (chain 8453) is for production.
#
# The BaseVault contract (TODO: not yet implemented) will
# lock tokens on Base before bridging to Zama fhEVM.
# ════════════════════════════════════════════════════════════

# ── Base RPC endpoints ──────────────────────────────────────
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ── BaseVault contract addresses ─────────────────────────────
# TODO: Deploy contracts/contracts/BaseVault.sol (does not exist yet)
# These are placeholders until the vault contract is implemented.
NEXT_PUBLIC_BASE_VAULT_ADDRESS_BASE=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BASE_VAULT_ADDRESS_BASE_SEPOLIA=0x0000000000000000000000000000000000000000

# ════════════════════════════════════════════════════════════
# LAYER 2: ZAMA fhEVM (Confidential Compute Chain)
# ════════════════════════════════════════════════════════════
# Zama fhEVM runs on a separate network with TFHE precompiles.
# These are NOT on Base — they require the Zama network.
# ════════════════════════════════════════════════════════════

# ── Zama Devnet (primary fhEVM testnet, chain ID 9000) ───────
NEXT_PUBLIC_CONTRACT_ADDRESS_ZAMA_DEVNET=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_STRATEGY_AGENT_ADDRESS_ZAMA_DEVNET=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ZAMA_DEVNET_RPC=https://devnet.zama.ai

# ── Ethereum Sepolia (chain 11155111, Zama has deployed fhEVM there) ──
NEXT_PUBLIC_CONTRACT_ADDRESS_SEPOLIA=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_STRATEGY_AGENT_ADDRESS_SEPOLIA=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_RPC_URL_SEPOLIA=https://rpc.sepolia.org

# ── Zama fhEVM System Contracts ──────────────────────────────
# Required by fhevmjs to encrypt inputs.
# Get current addresses from: https://docs.zama.ai/fhevm/references/contracts
NEXT_PUBLIC_FHEVM_ACL_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_FHEVM_KMS_ADDRESS=0x0000000000000000000000000000000000000000

# ════════════════════════════════════════════════════════════
# LAYER 3: BRIDGE / RELAYER (TODO — not yet implemented)
# ════════════════════════════════════════════════════════════
# A cross-chain bridge will connect Base deposits to Zama fhEVM.
# Options under consideration: LayerZero, Hyperlane, custom relayer.
# These variables are reserved for future use.
# ════════════════════════════════════════════════════════════

# NEXT_PUBLIC_BRIDGE_ADDRESS_BASE_SEPOLIA=
# NEXT_PUBLIC_RELAYER_URL=
