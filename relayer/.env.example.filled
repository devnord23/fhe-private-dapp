# relayer/.env — copy to relayer/.env
# Leave RELAYER_PRIVATE_KEY absent for read-only mode (events logged, no txns sent).

# ── Base Sepolia ───────────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# ← Fill in after Step A (BaseVault deploy)
BASE_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# ── Ethereum Sepolia (Zama fhEVM) ──────────────────────────────────────────────
# Use your Alchemy key (same as SEPOLIA_RPC_URL in contracts/.env)
ZAMA_DEVNET_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# ← Fill in after Step B and C
CONFIDENTIAL_STRATEGY_AGENT_ADDRESS=0x0000000000000000000000000000000000000000
CONFIDENTIAL_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# ── No private key = read-only mode ───────────────────────────────────────────
# Relayer will poll and log but NEVER sign transactions. Safe to run immediately.
# RELAYER_PRIVATE_KEY=0x...

# ── CRITICAL: keep disabled (default) ─────────────────────────────────────────
TESTNET_ONLY_AUTO_COMPLETE=false

# ── Polling config ─────────────────────────────────────────────────────────────
POLLING_INTERVAL_MS=12000
CONFIRMATION_BLOCKS=2
STATE_FILE_PATH=./state/state.json
LOG_LEVEL=info
