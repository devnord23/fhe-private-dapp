# contracts/.env — copy this to contracts/.env and fill in the two marked values
#
# ← YOU PROVIDE (2 things):
#   1. DEPLOYER_PRIVATE_KEY — the hex private key of your testnet wallet
#   2. SEPOLIA_RPC_URL      — your Alchemy/Infura Sepolia endpoint
#
# Everything else is pre-filled or optional.

# ── YOUR wallet private key (no 0x prefix needed for Hardhat) ─────────────────
# This wallet needs ETH on TWO chains:
#   Base Sepolia → https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
#   Eth Sepolia  → https://sepoliafaucet.com
# ← YOU PROVIDE
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Base Sepolia RPC — public endpoint, no key needed ─────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# ── Ethereum Sepolia RPC ───────────────────────────────────────────────────────
# ← YOU PROVIDE (or use the slow public one below)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# SEPOLIA_RPC_URL=https://rpc.sepolia.org   ← public fallback

# ── Optional (for Etherscan/Basescan contract verification) ───────────────────
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# ── Deploy scripts will auto-deploy MockERC20 when these are empty ────────────
# Leave blank — scripts handle it automatically
# UNDERLYING_TOKEN_ADDRESS=
# TEST_TOKEN_ADDRESS=

# ── Gas reporting (leave false unless profiling) ──────────────────────────────
REPORT_GAS=false
