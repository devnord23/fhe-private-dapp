# ============================================================
# Contracts – Environment Variables
# ============================================================
# Copy to .env and fill in values. Never commit .env.

# ── Deployer account ─────────────────────────────────────────
# Private key of the deployer wallet (without 0x prefix).
DEPLOYER_PRIVATE_KEY=your_private_key_here

# ════════════════════════════════════════════════════════════
# LAYER 1: BASE (Settlement Chain)
# ════════════════════════════════════════════════════════════
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Basescan API key for contract verification on Base
BASESCAN_API_KEY=

# ════════════════════════════════════════════════════════════
# LAYER 2: ZAMA fhEVM (Confidential Compute Chain)
# ════════════════════════════════════════════════════════════
# Zama Devnet (chain 9000) – primary fhEVM testnet
ZAMA_DEVNET_RPC=https://devnet.zama.ai

# Ethereum Sepolia (Zama also deploys fhEVM precompiles here)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Address of the public ERC-20 that ConfidentialToken wraps.
# On Zama Devnet: deploy MockERC20 first (npm run deploy:zamaDevnet)
UNDERLYING_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# ── Etherscan verification ────────────────────────────────────
ETHERSCAN_API_KEY=

# ── Gas reporting ─────────────────────────────────────────────
REPORT_GAS=false
