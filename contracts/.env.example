# ============================================================
# Contracts – Environment Variables
# ============================================================
# Copy to .env and fill in values. Never commit .env.

# ── Deployer account ─────────────────────────────────────────
# Private key of the deployer wallet (without 0x prefix).
DEPLOYER_PRIVATE_KEY=your_private_key_here

# ── RPC endpoints ────────────────────────────────────────────
# Zama Devnet (chain ID 9000) – primary fhEVM testnet
ZAMA_DEVNET_RPC=https://devnet.zama.ai

# Ethereum Sepolia (use only if Zama precompiles are live there)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# ── Underlying ERC-20 address ────────────────────────────────
# Address of the public ERC-20 that ConfidentialToken wraps.
# On a fresh Zama Devnet deployment you can deploy MockERC20 first.
UNDERLYING_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# ── Etherscan (optional, for contract verification) ──────────
ETHERSCAN_API_KEY=

# ── Gas reporting ────────────────────────────────────────────
REPORT_GAS=false
